{
  "name": "IG 5 - Error Monitor",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "hours",
              "hoursInterval": 1
            }
          ]
        }
      },
      "id": "2843a3df-7fc9-4c0a-8d1c-c3963a9301fa",
      "name": "Every hour",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.ENGINE_URL }}/api/jobs/monitor",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $env.ADMIN_TOKEN }}"
            }
          ]
        },
        "options": {
          "timeout": 600000
        }
      },
      "id": "bc8f20fd-337e-4b36-870a-6a5af570ebf9",
      "name": "Health check + alerts",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        260,
        0
      ],
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 5000,
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://api.telegram.org/bot{{ $env.TELEGRAM_BOT_TOKEN }}/sendMessage",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ chat_id: $env.TELEGRAM_CHAT_ID, text: 'Instagram automation engine is not responding. Action required: check the server.\n\n' + JSON.stringify($json).slice(0, 500) }) }}",
        "options": {}
      },
      "id": "af6bb790-1179-40b1-9c14-04116ddad6c6",
      "name": "Telegram: engine down",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        520,
        80
      ]
    },
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "days",
              "daysInterval": 1,
              "triggerAtHour": 3
            }
          ]
        }
      },
      "id": "338de9f4-e9b4-4ab7-8065-582099e853bc",
      "name": "Daily 03:00",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        220
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.ENGINE_URL }}/api/jobs/cleanup",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $env.ADMIN_TOKEN }}"
            }
          ]
        },
        "options": {
          "timeout": 600000
        }
      },
      "id": "cffda238-9676-403d-ba7e-0b639d7c3f42",
      "name": "Delete old drafts",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        260,
        220
      ],
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 5000
    },
    {
      "parameters": {
        "inputSource": "passthrough"
      },
      "id": "b8105797-0197-43cd-a82c-a63e83ef0970",
      "name": "Run on demand",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.1,
      "position": [
        0,
        -200
      ]
    }
  ],
  "connections": {
    "Every hour": {
      "main": [
        [
          {
            "node": "Health check + alerts",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Health check + alerts": {
      "main": [
        [],
        [
          {
            "node": "Telegram: engine down",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Daily 03:00": {
      "main": [
        [
          {
            "node": "Delete old drafts",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Run on demand": {
      "main": [
        [
          {
            "node": "Health check + alerts",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "timezone": "Asia/Kolkata",
    "saveDataSuccessExecution": "none",
    "saveManualExecutions": false,
    "saveDataErrorExecution": "all"
  },
  "active": false,
  "id": "f74dc95adb5b493f"
}
