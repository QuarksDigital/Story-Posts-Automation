{
  "name": "IG 2 - Post Generator",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 15
            }
          ]
        }
      },
      "id": "d9e83d23-8723-4934-983e-96fa5140a901",
      "name": "Every 15 min (engine acts only when due)",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.ENGINE_URL }}/api/jobs/generate-post",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $env.ADMIN_TOKEN }}"
            }
          ]
        },
        "options": {
          "timeout": 600000
        }
      },
      "id": "9afc939e-ab3e-4d79-9449-90bf42c519d7",
      "name": "Render + validate post",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        260,
        0
      ],
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 5000
    },
    {
      "parameters": {
        "inputSource": "passthrough"
      },
      "id": "5f4acb02-9360-4385-972b-dcaef5e305f1",
      "name": "Run on demand",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.1,
      "position": [
        0,
        -200
      ]
    }
  ],
  "connections": {
    "Every 15 min (engine acts only when due)": {
      "main": [
        [
          {
            "node": "Render + validate post",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Run on demand": {
      "main": [
        [
          {
            "node": "Render + validate post",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "timezone": "Asia/Kolkata",
    "saveDataSuccessExecution": "none",
    "saveManualExecutions": false,
    "saveDataErrorExecution": "all"
  },
  "active": false,
  "id": "28a3b86956034b9d"
}
