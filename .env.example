# ---- Engine ----------------------------------------------------------------
PORT=8080
# Public HTTPS address of the engine. Instagram downloads images from
# $PUBLIC_BASE_URL/media/... so it must be reachable from the internet when PUBLISH_MODE=live.
PUBLIC_BASE_URL=http://localhost:8080
# Protects the review page and API (browser login: any username + this password).
# Generate one with:  node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
ADMIN_TOKEN=
# internal = engine schedules itself (no n8n needed) | external = n8n calls the engine
SCHEDULER=internal
TICK_SECONDS=60

# ---- AI text model (one call per day) -----------------------------------------
# anthropic | openai (any OpenAI-compatible API incl. local Ollama) | mock (offline, free)
LLM_PROVIDER=mock
# anthropic default: claude-opus-5-5. Cheapest Claude: claude-haiku-4-5
LLM_MODEL=
LLM_EFFORT=low
ANTHROPIC_API_KEY=
# For LLM_PROVIDER=openai, e.g. Ollama: LLM_BASE_URL=http://localhost:11434/v1  LLM_MODEL=llama3.1:8b
LLM_BASE_URL=
AI_API_KEY=
USD_TO_INR=88

# ---- Instagram (official Graph API) ---------------------------------------------
# dry-run = do everything except the final API call | live = really publish
PUBLISH_MODE=dry-run
# Instagram Login: https://graph.instagram.com   Facebook Login: https://graph.facebook.com
GRAPH_API_BASE=https://graph.instagram.com
GRAPH_API_VERSION=v23.0
INSTAGRAM_ACCOUNT_ID=
META_ACCESS_TOKEN=
# Not used by the engine at runtime; keep them here for your own token tooling.
META_APP_ID=
META_APP_SECRET=
# auto | on | off  (auto refreshes Instagram-Login tokens weekly so they never hit 60-day expiry)
IG_TOKEN_REFRESH=auto
# Extra clients later: INSTAGRAM_ACCOUNT_ID__<SLUG>=...  META_ACCESS_TOKEN__<SLUG>=...

# ---- Telegram (free notifications + approve buttons) ------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_POLLING=true

# ---- VPS / Docker only ------------------------------------------------------------------
ENGINE_HOST=ig.example.com
N8N_HOST=n8n.example.com
N8N_ENCRYPTION_KEY=
